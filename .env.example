# Google AI Studio'dan aldığınız ücretsiz Gemini API anahtarı (https://aistudio.google.com/apikey)
GEMINI_API_KEY=buraya_anahtarinizi_yapistirin

# auto = anahtarınızın erişebildiği ücretsiz Flash-Lite / Flash modelini otomatik seçer (önerilen)
# Belirli bir model için örnek: GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL=auto

# İki Gemini isteği arasındaki en az bekleme (saniye). Ücretsiz katmanın dakikalık sınırı için.
GEMINI_MIN_INTERVAL=4

# 1 = Gemini ek marka denetimi yapar (+1 çağrı), 0 = yalnızca kod tabanlı denetim
AGENT_DEEP_REVIEW=1
